# --- LLM provider ---
LLM_PROVIDER=xai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast-reasoning
# XAI_VOICE=eve               # speech-to-speech voice; uses XAI_API_KEY (eve, ara, rex, sal, leo)
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_AGENT_MODEL=            # optional override for agent LLM
# OPENAI_API_KEY=            # used when LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o

# --- Grounding (web search) ---
EXA_API_KEY=

# --- App ---
APP_SECRET=                   # set in production: python -c "import secrets; print(secrets.token_hex(32))"
SERVICE_URL=https://lietuva.chat
PORT=5011
LOGIN=0                       # set 1 to require login for chat
# DB_URL=postgresql+psycopg2://user:pass@localhost:5432/lietuva   # optional
# ADMIN_EMAIL=                 # optional: seed an admin only when both fields are set
# ADMIN_PASSWORD=              # at least 12 characters
# MIGRATE_LEGACY_CHAT=1         # opt in only when importing old carhero chat data

# --- Authentication and email ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=                   # optional; falls back to APP_SECRET, then a random per-process key
POSTMARK_API_TOKEN=
FROM_EMAIL=info@lietuva.chat
FROM_NAME=lietuva.chat
TO_EMAIL=

# --- MCP server (optional) ---
# Chat app: call a deployed MCP server instead of in-process tools.
LIETUVA_MCP_URL=                  # e.g. https://mcp.lietuva.chat/mcp
LIETUVA_MCP_API_KEY=              # an lk_… key issued with `python -m mcp_server.keys new`
# MCP server process:
MCP_API_KEY_HASHES=               # comma-separated sha256 hashes of issued keys
MCP_ANON_RPM=30
MCP_ANON_RPD=500
MCP_KEY_RPM=300
MCP_KEY_RPD=20000
